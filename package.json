{
  "name": "qingyin",
  "private": true,
  "version": "0.1.0",
  "description": "轻音 - 精简版音源音乐播放器",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:plugin": "node scripts/test-plugin.mjs",
    "sync": "npm run build && cap sync ios"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@capacitor/core": "6.2.0",
    "@capacitor/filesystem": "6.0.0",
    "@capacitor/share": "6.0.0",
    "@qingyin/player": "file:plugins/qingyin-player",
    "crypto-js": "4.2.0",
    "dayjs": "1.11.13",
    "he": "1.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.0",
    "@capacitor/ios": "6.2.0",
    "@types/crypto-js": "4.2.2",
    "@types/he": "1.2.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "axios": "^1.21.0",
    "cheerio": "^1.2.0",
    "playwright-core": "^1.65.0",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
